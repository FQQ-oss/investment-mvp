# Copy these variables into the PowerShell session before starting the server.
TUSHARE_TOKEN=replace_with_your_tushare_token

# DeepSeek is used by the Agent analysis endpoint.
DEEPSEEK_API_KEY=replace_with_your_deepseek_key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
LLM_PROVIDER=deepseek

# Local proxy, if your network requires Clash.
HTTP_PROXY=http://127.0.0.1:7897
HTTPS_PROXY=http://127.0.0.1:7897
ALL_PROXY=http://127.0.0.1:7897
NODE_USE_ENV_PROXY=1
